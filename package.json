  "scripts": {
    "dev": "NODE_ENV=development tsx watch server.ts",
    "build": "drizzle-kit push && vite build && esbuild server.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/server.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
